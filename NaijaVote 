// ─── TAG CLASSES ──────────────────────────────────────────────────────────────
const tagClass = { "Getting Started":"tag-start","Your Rights":"tag-rights","Institutions":"tag-inst","The Law":"tag-law" };

function tagBadge(tag) {
  return `<span class="tag ${tagClass[tag]||'tag-start'}">${tag}</span>`;
}

// ─── NAVIGATION ───────────────────────────────────────────────────────────────
let previousScreen = 'topics';

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
  document.querySelectorAll('.top-nav button').forEach((b,i)=>{
    b.classList.toggle('active', ['home','topics','search','quiz'][i]===id);
  });
  document.querySelectorAll('.bottom-nav button').forEach((b,i)=>{
    b.classList.toggle('active', ['home','topics','search','quiz'][i]===id);
  });
  if (id==='search') setTimeout(()=>document.getElementById('search-input').focus(), 100);
  window.scrollTo(0,0);
}

// ─── TOPICS ───────────────────────────────────────────────────────────────────
function topicCardHTML(t) {
  return `<div class="topic-card" onclick="openTopic('${t.id}')">
    <div class="icon">${t.icon}</div>
    <div class="title">${t.title}</div>
    ${tagBadge(t.tag)}
    <div class="summ">${t.summary}</div>
  </div>`;
}

function renderTopicGrids() {
  const html = topics.map(topicCardHTML).join('');
  document.getElementById('home-topic-grid').innerHTML = html;
  document.getElementById('topics-grid').innerHTML = html;
}

function openTopic(id) {
  previousScreen = document.querySelector('.screen.active').id.replace('screen-','');
  const t = topics.find(x=>x.id===id);
  document.getElementById('detail-icon').textContent = t.icon;
  document.getElementById('detail-title').textContent = t.title;
  const tagEl = document.getElementById('detail-tag');
  tagEl.textContent = t.tag;
  tagEl.className = 'tag '+(tagClass[t.tag]||'tag-start');
  document.getElementById('detail-body').innerHTML = t.sections.map((s,i)=>`
    <div class="section-item">
      <div class="sec-num">${i+1}</div>
      <div class="sec-content">
        <div class="sec-heading">${s.heading}</div>
        <div class="sec-body">${s.body}</div>
      </div>
    </div>`).join('');
  document.getElementById('detail-source').innerHTML = `📖 ${t.source}`;
  showScreen('detail');
}

function goBackToTopics() {
  showScreen(previousScreen==='home'?'home':'topics');
}

// ─── SEARCH ───────────────────────────────────────────────────────────────────
function buildIndex() {
  const idx = [];
  topics.forEach(t=>{
    idx.push({id:t.id,type:'topic',title:t.title,text:t.summary,topicId:t.id,icon:t.icon});
    t.sections.forEach(s=>{
      idx.push({id:t.id+'-'+s.heading,type:'section',title:s.heading,text:s.body,topicId:t.id,icon:t.icon,inTopic:t.title});
    });
  });
  return idx;
}
const searchIndex = buildIndex();

function doSearch() {
  const q = document.getElementById('search-input').value;
  const popular = document.getElementById('popular-section');
  const results = document.getElementById('search-results');
  if (!q.trim()) { popular.style.display='block'; results.innerHTML=''; return; }
  popular.style.display='none';
  const words = q.toLowerCase().split(/\s+/).filter(w=>w.length>1);
  const hits = searchIndex.map(item=>{
    const hay = (item.title+' '+item.text).toLowerCase();
    const score = words.reduce((s,w)=>s+(hay.includes(w)?1:0),0);
    return {...item,score};
  }).filter(i=>i.score>0).sort((a,b)=>b.score-a.score).slice(0,6);

  if (!hits.length) {
    results.innerHTML=`<div class="no-results"><div style="font-size:36px;margin-bottom:10px">🤷</div><div style="font-weight:700;margin-bottom:4px;color:var(--text)">No results found</div><div>Try different words, or browse all topics.</div><button class="btn-green" style="margin-top:14px;font-size:13px;" onclick="showScreen('topics')">Browse All Topics</button></div>`;
    return;
  }
  results.innerHTML = hits.map(r=>`
    <button class="result-card" onclick="openTopic('${r.topicId}')">
      <div class="result-top">
        <span class="r-icon">${r.icon}</span>
        <span class="r-title">${r.title}</span>
        ${r.type==='section'?`<span class="r-in">in ${r.inTopic}</span>`:''}
      </div>
      <div class="result-text">${r.text.slice(0,120)}…</div>
    </button>`).join('');
}

function setSearch(q) {
  document.getElementById('search-input').value = q;
  doSearch();
}

// ─── QUIZ ─────────────────────────────────────────────────────────────────────
let quiz = {};

function initQuiz() {
  quiz = { questions:[...quizQuestions].sort(()=>Math.random()-.5), index:0, score:0, selected:null, done:false };
  renderQuiz();
}

function renderQuiz() {
  if (quiz.done) { renderScore(); return; }
  const q = quiz.questions[quiz.index];
  const pct = (quiz.index/quiz.questions.length)*100;
  document.getElementById('quiz-container').innerHTML = `
    <div class="quiz-meta">
      <span>Question ${quiz.index+1} of ${quiz.questions.length}</span>
      <span class="q-score">Score: ${quiz.score}</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
    <div class="quiz-question">${q.q}</div>
    <div class="options">${q.options.map((o,i)=>`<button class="opt-btn" id="opt-${i}" onclick="answerQuiz(${i})">${o}</button>`).join('')}</div>
    <div id="quiz-feedback" style="display:none">
      <div class="explanation">💡 <strong>Explanation:</strong> ${q.explanation}</div>
      <button class="btn-next" onclick="nextQuestion()">${quiz.index+1>=quiz.questions.length?'See My Score':'Next Question →'}</button>
    </div>`;
}

function answerQuiz(idx) {
  if (quiz.selected!==null) return;
  quiz.selected = idx;
  const correct = quiz.questions[quiz.index].answer;
  if (idx===correct) quiz.score++;
  quiz.questions[quiz.index].options.forEach((_,i)=>{
    const btn = document.getElementById('opt-'+i);
    btn.disabled = true;
    if (i===correct) btn.classList.add('correct');
    else if (i===idx) btn.classList.add('wrong');
  });
  document.getElementById('quiz-feedback').style.display='block';
}

function nextQuestion() {
  quiz.index++;
  quiz.selected = null;
  if (quiz.index>=quiz.questions.length) { quiz.done=true; renderScore(); }
  else renderQuiz();
}

function renderScore() {
  const total = quiz.questions.length;
  const pct = Math.round((quiz.score/total)*100);
  const emoji = pct>=80?'🏆':pct>=60?'👍':'📚';
  const msg = pct>=80?'Excellent! You are a well-informed Nigerian voter.':pct>=60?'Good effort! Keep reading to sharpen your knowledge.':'No worries — browse the topics and try again!';
  const barColor = pct>=80?'#008751':pct>=60?'#c9a027':'#bf3b2b';
  document.getElementById('quiz-container').innerHTML=`
    <div class="score-screen">
      <div class="score-emoji">${emoji}</div>
      <div class="score-big">${quiz.score}<span style="font-size:24px;color:var(--muted)">/${total}</span></div>
      <div class="score-pct">${pct}% correct</div>
      <div class="score-msg">${msg}</div>
      <div class="score-bar-wrap"><div class="score-bar-fill" style="width:${pct}%;background:${barColor}"></div></div>
      <div class="score-actions">
        <button class="btn-next" onclick="initQuiz()">Retry Quiz</button>
        <button class="btn-outline" onclick="showScreen('topics')">Study Topics</button>
      </div>
    </div>`;
}

// ─── BOOT ─────────────────────────────────────────────────────────────────────
renderTopicGrids();
initQuiz();
